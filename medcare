CREATE TABLE pacientes (
    id SERIAL PRIMARY KEY,
    nome VARCHAR(150) NOT NULL,
    email VARCHAR(150) NOT NULL UNIQUE,
    cpf CHAR(11) NOT NULL UNIQUE,
    data_nascimento DATE NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL
);

CREATE TABLE especialidades (
    id SERIAL PRIMARY KEY,
    nome VARCHAR(100) NOT NULL UNIQUE
);

CREATE TABLE medicos (
    id SERIAL PRIMARY KEY,
    especialidade_id INT NOT NULL REFERENCES especialidades(id),
    nome VARCHAR(150) NOT NULL,
    crm VARCHAR(20) NOT NULL UNIQUE
);

CREATE TABLE tabela_precos (
    id SERIAL PRIMARY KEY,
    medico_id INT NOT NULL REFERENCES medicos(id),
    valor_consulta NUMERIC(10, 2) NOT NULL CHECK (valor_consulta > 0),
    data_inicio DATE NOT NULL,
    data_fim DATE
);

CREATE TABLE consultas (
    id SERIAL PRIMARY KEY,
    medico_id INT NOT NULL REFERENCES medicos(id),
    paciente_id INT NOT NULL REFERENCES pacientes(id),
    data_hora TIMESTAMP NOT NULL,
    status VARCHAR(20) DEFAULT 'Agendada' NOT NULL CHECK (status IN ('Agendada', 'Realizada', 'Cancelada'))
);

CREATE TABLE exames_consulta (
    id SERIAL PRIMARY KEY,
    consulta_id INT NOT NULL REFERENCES consultas(id) ON DELETE CASCADE,
    nome_exame VARCHAR(150) NOT NULL,
    valor_exame NUMERIC(10, 2) NOT NULL CHECK (valor_exame >= 0)
);

CREATE TABLE faturamentos (
    id SERIAL PRIMARY KEY,
    consulta_id INT NOT NULL UNIQUE REFERENCES consultas(id),
    valor_consulta_cobrado NUMERIC(10, 2) NOT NULL CHECK (valor_consulta_cobrado >= 0),
    valor_exames_cobrado NUMERIC(10, 2) DEFAULT 0 NOT NULL CHECK (valor_exames_cobrado >= 0),
    valor_total NUMERIC(10, 2) GENERATED ALWAYS AS (valor_consulta_cobrado + valor_exames_cobrado) STORED,
    data_pagamento TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL
);



